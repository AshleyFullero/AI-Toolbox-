# ============================================================
# AI Toolbox – Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to source control.
# ============================================================

# ---- Database -----------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ai_toolbox?schema=public"

# ---- NextAuth.js --------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# The canonical URL of your deployment
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth (optional) --------------------------------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---- GitHub OAuth (optional) --------------------------------
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# ---- OpenAI API ---------------------------------------------
OPENAI_API_KEY="sk-..."

# ---- Replicate API (image generation) -----------------------
REPLICATE_API_TOKEN="r8_..."

# ---- Stripe (optional – skeleton only) ----------------------
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ---- App Settings -------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AI Toolbox"
